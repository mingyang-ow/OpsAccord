# OpsAccord local configuration. Copy to .env and edit as needed.
#
# Every setting is prefixed with OPSACCORD_ and is read from the process
# environment first, then from .env. This file contains no secrets: reference
# credential environment variables by name only and export them in your shell.

# --- persistence ----------------------------------------------------------
# Project-local PostgreSQL provisioned by scripts/pg.sh (see docs/development.md).
OPSACCORD_DATABASE_URL=postgresql+psycopg://opsaccord@127.0.0.1:55432/opsaccord
OPSACCORD_TEST_DATABASE_URL=postgresql+psycopg://opsaccord@127.0.0.1:55432/opsaccord_test
# Optional override. Defaults to the state database for the selected app_env.
#OPSACCORD_GRAPH_CHECKPOINT_URL=

# app_env=test|ci selects the test database for authoritative state *and* graph
# checkpoints, so a recovery test can never resume against a different database.
OPSACCORD_APP_ENV=dev

# --- local services -------------------------------------------------------
OPSACCORD_API_HOST=127.0.0.1
OPSACCORD_API_PORT=8410
OPSACCORD_UI_PORT=8511
OPSACCORD_API_BASE_URL=http://127.0.0.1:8410

# --- demo environment -----------------------------------------------------
# Simulated execution surface only. Live mode is refused until a live adapter
# exists, so simulated evidence can never be reported as live telemetry.
OPSACCORD_DEMO_MODE=simulated
# Pinned upstream revision; provenance and verified flags are in
# docs/astronomy-shop.md.
OPSACCORD_ASTRONOMY_SHOP_REVISION=3.1.0
OPSACCORD_METRICS_BASE_URL=http://127.0.0.1:19090

# --- application runtime reasoning model ----------------------------------
# Explicit provider/model choice. The coding agent's own configuration never
# selects the application's runtime model.
OPSACCORD_MODEL_PROVIDER=deterministic
OPSACCORD_MODEL_ID=deterministic-v1
OPSACCORD_MODEL_BASE_URL=https://api.deepseek.com/v1
# Name of the environment variable that holds the key; the key itself is never
# stored in the repository. Export DEEPSEEK_API_KEY in your shell if needed.
OPSACCORD_MODEL_API_KEY_ENV=DEEPSEEK_API_KEY
OPSACCORD_MODEL_TIMEOUT_SECONDS=45
OPSACCORD_MODEL_MAX_OUTPUT_TOKENS=1200

# Paid application-model calls are off by default. Turn this on only with an
# explicit budget, and set the rates below so cost is recorded as known.
OPSACCORD_ALLOW_PAID_MODEL_CALLS=false
#OPSACCORD_MODEL_INPUT_COST_PER_1K_USD=
#OPSACCORD_MODEL_OUTPUT_COST_PER_1K_USD=

# --- deterministic budgets and limits -------------------------------------
OPSACCORD_SOFT_STEP_BUDGET=8
OPSACCORD_HARD_STEP_CAP=16
OPSACCORD_MAX_BUDGET_EXTENSIONS=2
OPSACCORD_MAX_ACTIONS_PER_INCIDENT=2
OPSACCORD_READ_ATTEMPTS=3
OPSACCORD_READ_DEADLINE_SECONDS=2
OPSACCORD_ACTION_TIMEOUT_SECONDS=5
OPSACCORD_APPROVAL_TTL_SECONDS=900
